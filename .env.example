# AgentRouter (preferred) — OpenAI-compatible gateway
AGENTROUTER_API_KEY=sk-your-key-here
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
# Exact model id from AgentRouter (e.g. deepseek-v4.1-flash). No silent fallback.
AGENTROUTER_MODEL=deepseek-v4.1-flash

# Fallback aliases (optional; used only if AGENTROUTER_* are unset)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=

# Notes:
# - Do not commit .env (secrets).
# - Some gateways require /v1/responses for certain models; darsamooz retries that
#   endpoint for the SAME configured model only (it does not switch models).
