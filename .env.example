# Provider selector: gemini | openrouter | openai
LLM_PROVIDER=gemini

# --- Gemini (default) — OpenAI-compatible endpoint ---
GEMINI_API_KEY=
# Exact model id (list via models API). Prefer a Flash model, e.g. gemini-3.6-flash.
# No silent model fallback — set explicitly.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- OpenRouter (optional; free models end with :free) ---
# LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# Prefer google/gemma-4-31b-it:free when the free pool is not rate-limited
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- OpenAI-compatible (optional) ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=

# Notes:
# - Do not commit .env (secrets). Keep API keys only in local gitignored .env.
# - Generation uses extracted chapter PDF text. Provider/model errors are raised
#   (no silent syllabus or model fallback).
