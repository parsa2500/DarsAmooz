# Provider selector: openrouter | gemini | openai (default: openrouter)
LLM_PROVIDER=openrouter
# Visible API fallback when the primary provider errors (429/quota, 5xx, timeouts,
# other HTTP/API failures). Leave empty / none / off to disable.
# On fallback: warning is logged; provider/model + counts/reasons go into
# run items, metrics.json, and the web UI job status. Not silent.
# Default: OFF — every LLM call (generate, verify, topic, patterns) goes to OpenRouter only.
# Set to gemini to re-enable the optional visible fallback.
LLM_FALLBACK_PROVIDER=
# --- Gemini (optional; not used unless LLM_PROVIDER/LLM_FALLBACK_PROVIDER=gemini) ---
GEMINI_API_KEY=
# Exact model id (list via models API). Prefer a Flash model, e.g. gemini-3.6-flash.
# No silent model fallback — set explicitly.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- OpenRouter (default primary; free models end with :free) ---
# LLM_PROVIDER=gemini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# Prefer google/gemma-4-31b-it:free when the free pool is not rate-limited
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- OpenAI-compatible (optional) ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=

# Notes:
# - Do not commit .env (secrets). Keep API keys only in local gitignored .env.
# - Generation uses extracted chapter PDF text. There is no silent syllabus or
#   model fallback. When LLM_FALLBACK_PROVIDER is set, API errors on the primary
#   visibly switch to that provider (logged + recorded in metrics).
# - If primary and fallback both fail, darsamooz raises a clear combined error.

# Optional: override model used only for the blind answer-verification pass.
# When unset, verification uses the same provider/model as generation.
# VERIFY_MODEL=

# Style mining («الگوبرداری وب») uses the same LLM keys above.
# With OPENROUTER_API_KEY, OpenRouter web_search is preferred; otherwise the
# selected provider distills style patterns. Facts still come from your PDF.


# Handout flow web search («جستجوی تست‌های واقعی»):
# auto = Tavily (when TAVILY_API_KEY is set) -> Google CSE (when both CSE vars
# are set) -> keyless DuckDuckGo. Gemini grounding only with --backend gemini.
# Tavily (recommended): https://app.tavily.com — monthly free allowance.
# Never commit the real key.
TAVILY_API_KEY=
# Optional country boost (default iran; set to none to disable).
# TAVILY_COUNTRY=iran
# Google Custom Search JSON API is closed to new customers
# (https://developers.google.com/custom-search/v1/overview) and shuts down for
# remaining users on 1 January 2027. Leave empty unless you already have access.
# 100 free queries/day when it works. Never commit real values.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
# Max search requests per mining run (all backends together). Default 6.
WEB_SEARCH_MAX_QUERIES=6
# Optional CSE filters (set to none to disable): language and country.
# GOOGLE_CSE_LR=lang_fa
# GOOGLE_CSE_GL=ir
# Optional: model used only for --backend gemini (defaults to GEMINI_MODEL).
# GEMINI_SEARCH_MODEL=
