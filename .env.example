# AgentRouter (preferred) — OpenAI-compatible gateway
AGENTROUTER_API_KEY=sk-your-key-here
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
# Preferred model. If unavailable on your plan, darsamooz falls back to /v1/models.
AGENTROUTER_MODEL=deepseek-v4-flash

# Fallback aliases (optional; used only if AGENTROUTER_* are unset)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=

# Notes:
# - AgentRouter may require the Responses API (/v1/responses) for some models.
# - Do not commit .env (secrets).
