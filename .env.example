# Provider selector: openrouter | gemini | openai (default: openrouter)
LLM_PROVIDER=openrouter
# Visible API fallback when the primary provider errors (429/quota, 5xx, timeouts,
# other HTTP/API failures). Leave empty / none / off to disable.
# On fallback: warning is logged; provider/model + counts/reasons go into
# run items, metrics.json, and the web UI job status. Not silent.
LLM_FALLBACK_PROVIDER=gemini
# --- Gemini (fallback / optional primary) — OpenAI-compatible endpoint ---
GEMINI_API_KEY=
# Exact model id (list via models API). Prefer a Flash model, e.g. gemini-3.6-flash.
# No silent model fallback — set explicitly.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- OpenRouter (default primary; free models end with :free) ---
# LLM_PROVIDER=gemini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# Prefer google/gemma-4-31b-it:free when the free pool is not rate-limited
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- OpenAI-compatible (optional) ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=

# Notes:
# - Do not commit .env (secrets). Keep API keys only in local gitignored .env.
# - Generation uses extracted chapter PDF text. There is no silent syllabus or
#   model fallback. When LLM_FALLBACK_PROVIDER is set, API errors on the primary
#   visibly switch to that provider (logged + recorded in metrics).
# - If primary and fallback both fail, darsamooz raises a clear combined error.

# Optional: override model used only for the blind answer-verification pass.
# When unset, verification uses the same provider/model as generation.
# VERIFY_MODEL=

